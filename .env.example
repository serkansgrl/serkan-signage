# Copy to .env, then set a long, unique password.
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8098
TZ=Europe/Berlin
# Set to true when using HTTPS.
COOKIE_SECURE=false
# Optional allow-list of origins for iframe embedding of the public display only.
FRAME_ANCESTORS=
# Optional host NAS photo folder, mounted read-only inside the container.
NAS_PHOTOS_PATH=./examples/nas-photos
NEWS_FEEDS=https://nachrichtenfeeds.br.de/rdf/boards/UZlMIJH,https://nachrichtenfeeds.br.de/rss/nachrichten/seiten/QXAPkQJ
NEWS_ALLOWED_HOSTS=www.br.de,br.de
NEWS_SOURCE_LABEL=BR24
