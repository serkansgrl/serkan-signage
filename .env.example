# Copy to .env and replace the example password BEFORE starting the container.
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8098
TZ=Europe/Berlin
# Set true when serving via HTTPS.
COOKIE_SECURE=false
# Trusted origins allowed to embed ONLY the public display, e.g. https://display.example.org
FRAME_ANCESTORS=
# NAS photos must already be mounted on the Docker host. Mounted read-only in the container.
NAS_PHOTOS_PATH=./examples/nas-photos
NEWS_FEEDS=https://nachrichtenfeeds.br.de/rdf/boards/UZlMIJH,https://nachrichtenfeeds.br.de/rss/nachrichten/seiten/QXAPkQJ
NEWS_ALLOWED_HOSTS=www.br.de,br.de
NEWS_SOURCE_LABEL=BR24
